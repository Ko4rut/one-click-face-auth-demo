# Server-only URL of the Python AI backend.
# The browser does not call this URL directly; Next.js Route Handlers proxy requests to it.
AI_API_BASE_URL=http://127.0.0.1:8000

# Provisional REST paths. Keep them configurable until the Python API layer is finalized.
AI_ENROLL_PATH=/enroll
AI_IDENTIFY_PATH=/identify
AI_HEALTH_PATH=/health
