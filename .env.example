# Server-only URL of the Python AI backend.
# Browser requests go through Next.js Route Handlers.
AI_API_BASE_URL=http://127.0.0.1:8000

# Enrollment is fixed by the current backend contract:
# POST /api/v1/enrollment

# Other paths remain configurable until their contracts are finalized.
AI_IDENTIFY_PATH=/identify
AI_HEALTH_PATH=/health
